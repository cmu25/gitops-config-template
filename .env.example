# Copy this file to .env and fill in the values below.
# .env is git-ignored — never commit real credentials.

# --- GitHub App credentials (for ArgoCD to pull from the config repo) ---
# Find these on your GitHub App's settings page:
#   https://github.com/settings/apps/<your-app-slug>
#
# BOT_ID: shown at the top of the app settings page as "App ID"
BOT_ID=

# BOT_APP_INSTALLATION_ID: visible in the URL after installing the app on a repo/org,
#   e.g. https://github.com/settings/installations/12345678 -> 12345678
BOT_APP_INSTALLATION_ID=

# BOT_PRIVATE_KEY: downloaded as a .pem file when you generated a private key
#   for the app. Paste the FULL contents here, including the BEGIN/END lines.
#   Tip: BOT_PRIVATE_KEY="$(cat path/to/private-key.pem)"
BOT_PRIVATE_KEY=

# --- Optional: database credentials for `task seal-secrets` ---
# If left blank, the task will prompt you interactively instead.
DB_USERNAME=
DB_PASSWORD=
